# Copy this file to .env.oracle on the Oracle VM and replace every placeholder.
# For an IP such as 203.0.113.10, SWIFTDESK_DOMAIN can be
# swiftdesk.203-0-113-10.sslip.io.
SWIFTDESK_DOMAIN=swiftdesk.<PUBLIC-IP-WITH-DASHES>.sslip.io
REMOTEDESK_BOOTSTRAP_TOKEN=<GENERATE-A-32-BYTE-SECRET>
REMOTEDESK_OPERATOR_KEY=<GENERATE-A-DIFFERENT-32-BYTE-SECRET>
REMOTEDESK_SIGNING_KEY=<GENERATE-A-DIFFERENT-32-BYTE-SECRET>
SWIFTDESK_DB_PASSWORD=<GENERATE-A-DIFFERENT-32-BYTE-SECRET>

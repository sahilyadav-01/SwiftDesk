<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SwiftDesk Remote Desktop"
           Manufacturer="SwiftDesk Technologies"
           Version="1.2.3"
           UpgradeCode="4C6F4B61-9E2A-4B6A-8A9C-7F6F1D9E3B4C"
           Language="1033"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of SwiftDesk is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="SwiftDeskAppIcon" SourceFile="!(bindpath.PublishDir)\SwiftDesk.ico" />
    <Property Id="ARPPRODUCTICON" Value="SwiftDeskAppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SwiftDesk">
        <Component Id="PrivilegedHelperService" Guid="7F8A9B0C-1D2E-3F4A-5B6C-7D8E9F0A1B2C">
          <File Source="!(bindpath.PublishDir)\RemoteDesk.PrivilegedHelper.exe" KeyPath="yes" />
          <ServiceInstall
              Id="SwiftDeskHelperServiceInstall"
              Name="SwiftDeskPrivilegedHelper"
              DisplayName="SwiftDesk Privileged Remote Reboot Helper"
              Description="Least-privilege helper service executing authenticated, signed, and rate-limited remote reboots for SwiftDesk."
              Type="ownProcess"
              Account="LocalSystem"
              Start="auto"
              ErrorControl="normal" />
          <ServiceControl
              Id="SwiftDeskHelperServiceControl"
              Name="SwiftDeskPrivilegedHelper"
              Start="install"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
        </Component>
        <Component Id="RuntimeConfiguration" Guid="B2C3D4E5-F607-4819-A0B1-C2D3E4F50617">
          <Environment Id="SwiftDeskServerEnvironment"
                       Name="REMOTEDESK_SERVER"
                       Value="$(var.ServerUrl)"
                       Action="set"
                       Part="all"
                       System="yes" />
          <Environment Id="SwiftDeskBootstrapEnvironment"
                       Name="REMOTEDESK_BOOTSTRAP_TOKEN"
                       Value="$(var.BootstrapToken)"
                       Action="set"
                       Part="all"
                       System="yes" />
          <Environment Id="SwiftDeskOperatorEnvironment"
                       Name="REMOTEDESK_OPERATOR_KEY"
                       Value="$(var.OperatorKey)"
                       Action="set"
                       Part="all"
                       System="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\SwiftDesk"
                         Name="runtimeConfiguration"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.PublishDir)\**">
        <Exclude Files="!(bindpath.PublishDir)\RemoteDesk.PrivilegedHelper.exe" />
        <Exclude Files="!(bindpath.PublishDir)\*.pdb" />
        <Exclude Files="!(bindpath.PublishDir)\*.key.sample" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="SwiftDeskDataFolder" Name="SwiftDesk">
        <Component Id="MachineSecretDirectory" Guid="8A9B0C1D-2E3F-4A5B-6C7D-8E9F0A1B2C3D" NeverOverwrite="yes">
          <CreateFolder>
            <Permission User="NT AUTHORITY\SYSTEM" GenericAll="yes" />
            <Permission User="Administrators" GenericAll="yes" />
          </CreateFolder>
          <File Id="RebootKeyFile" Source="!(bindpath.PublishDir)\reboot.key.sample" Name="reboot.key" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SwiftDesk">
        <Component Id="ApplicationShortcut" Guid="9A8B7C6D-5E4F-3A2B-1C0D-9E8F7A6B5C4D">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="SwiftDesk"
                    Description="SwiftDesk Cross-Platform Remote Desktop Client"
                    Target="[INSTALLFOLDER]RemoteDesk.Client.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="SwiftDeskAppIcon" />
          <Shortcut Id="AgentStartMenuShortcut"
                    Name="SwiftDesk Agent"
                    Description="SwiftDesk Remote Desktop Agent"
                    Target="[INSTALLFOLDER]RemoteDesk.Agent.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="SwiftDeskAppIcon" />
          <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\SwiftDesk" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="SwiftDesk"
                  Description="SwiftDesk Cross-Platform Remote Desktop Client"
                  Target="[INSTALLFOLDER]RemoteDesk.Client.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="SwiftDeskAppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SwiftDesk" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder">
      <Component Id="AgentStartupShortcut" Guid="C3D4E5F6-0718-492A-B1C2-D3E4F5061728">
        <Shortcut Id="AgentStartupShortcutLink"
                  Name="SwiftDesk Agent"
                  Description="Starts the SwiftDesk remote support Agent"
                  Target="[INSTALLFOLDER]RemoteDesk.Agent.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\SwiftDesk"
                       Name="agentStartupShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainApplication" Title="SwiftDesk Core" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="PrivilegedHelperService" />
      <ComponentRef Id="RuntimeConfiguration" />
      <ComponentRef Id="MachineSecretDirectory" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="AgentStartupShortcut" />
    </Feature>
  </Package>
</Wix>

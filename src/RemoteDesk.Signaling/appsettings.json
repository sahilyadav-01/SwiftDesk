{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RemoteDesk": {
    "BootstrapToken": "local-bootstrap-change-me",
    "OperatorKey": "local-operator-change-me",
    "SigningKey": "local-signing-key-change-me-32-bytes-minimum",
    "RequestLifetimeMinutes": 5,
    "TicketLifetimeMinutes": 10
  }
}

